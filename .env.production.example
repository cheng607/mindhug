# 生产环境 Docker Compose 配置示例
# 复制为 .env 后执行: docker compose up -d --build

POSTGRES_USER=mindhug
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mindhug

JWT_SECRET_KEY=change-me-long-random-jwt-secret

# 用户浏览器访问的前端地址（忘记密码邮件链接、与 CORS 保持一致）
# 本地 Docker：http://localhost
# 线上 HTTPS：https://your-domain.com
FRONTEND_URL=http://localhost

# 前端访问地址（CORS），JSON 数组格式，需包含 FRONTEND_URL 的 origin
CORS_ORIGINS=["http://localhost","https://your-domain.com"]

# 忘记密码：重置 token 有效期（分钟）
RESET_TOKEN_EXPIRE_MINUTES=30

# ── 邮件 SMTP（忘记密码；留空 SMTP_HOST 则链接仅写入 backend 日志）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mindhug.local
SMTP_USE_TLS=true

# LLM 配置（可选，默认 mock）
LLM_PROVIDER=mock
# LLM_API_KEY=sk-your-api-key

HTTP_PORT=80

# 限流（生产默认开启，Redis 多 worker 共享计数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_STRICT=20
RATE_LIMIT_WINDOW_SECONDS=60
