# 生产环境 Docker Compose 配置示例
# 复制为 .env 后执行: docker compose up -d

POSTGRES_USER=mindhug
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mindhug

JWT_SECRET_KEY=change-me-long-random-jwt-secret

# 前端访问地址（用于 CORS），JSON 数组格式
CORS_ORIGINS=["http://localhost","http://your-domain.com"]

# LLM 配置（可选，默认 mock）
LLM_PROVIDER=mock
# LLM_API_KEY=sk-your-api-key

HTTP_PORT=80

# 限流（生产默认开启，Redis 多 worker 共享计数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_STRICT=20
RATE_LIMIT_WINDOW_SECONDS=60
