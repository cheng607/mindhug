# Database
DATABASE_URL=postgresql://mindhug:mindhug@localhost:5432/mindhug
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
DEBUG=true
UPLOAD_DIR=uploads

# 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_STRICT=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── LLM 配置（真实对话体验）──────────────────────────────────────
# 1. 将 LLM_PROVIDER 改为 deepseek / openai / qwen
# 2. 填入 LLM_API_KEY
# 3. 重启后端：uvicorn app.main:app --reload --port 8000
#
# mock = 固定模板（仅测试用）；配置 API Key 后自动启用真实 LLM
LLM_PROVIDER=mock

# DeepSeek（推荐，性价比高）
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-在此填入你的密钥
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-在此填入你的密钥
# LLM_MODEL=gpt-4o-mini

# 通义千问
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-在此填入你的密钥
# LLM_MODEL=qwen-turbo

LLM_MAX_CONTEXT_MESSAGES=20
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Embedding（RAG；配置 LLM_API_KEY 后建议一并启用真实 Embedding）
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=3
