# Database
DATABASE_URL=postgresql://mindhug:mindhug@localhost:5432/mindhug
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
DEBUG=true
UPLOAD_DIR=uploads

# 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_STRICT=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── LLM 配置（真实对话体验）──────────────────────────────────────
# 1. 将 LLM_PROVIDER 改为 deepseek / openai / qwen
# 2. 填入 LLM_API_KEY
# 3. 重启后端：uvicorn app.main:app --reload --port 8000
# 注意：LLM_PROVIDER 在 .env 中只能出现一次，重复设置时后者会覆盖前者
#
# mock = 固定模板（仅测试用）；配置 API Key 后改为 deepseek 等
LLM_PROVIDER=mock

# DeepSeek（推荐，性价比高）
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-在此填入你的密钥
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-在此填入你的密钥
# LLM_MODEL=gpt-4o-mini

# 通义千问
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-在此填入你的密钥
# LLM_MODEL=qwen-turbo

LLM_MAX_CONTEXT_MESSAGES=20
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Embedding（RAG；配置 LLM_API_KEY 后建议一并启用真实 Embedding）
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_DIM=384
# RAG_TOP_K=3

# 白名单联网搜索（知识意图下，本地 RAG 不足时补充；默认开启）
# WHITELIST_SEARCH_ENABLED=true
# WHITELIST_SEARCH_DOMAINS=www.nhc.gov.cn,www.chinacdc.cn,www.who.int,www.cdc.gov
# WHITELIST_SEARCH_SCORE_THRESHOLD=0.32
# WHITELIST_SEARCH_TOP_K=2
# WHITELIST_SEARCH_TIMEOUT=8

# 认证 Cookie（Q-06，前端 withCredentials 自动携带）
# AUTH_COOKIE_NAME=access_token

# 忘记密码 / 邮件（F-01；未配置 SMTP 时重置链接写入后端日志）
# FRONTEND_URL=http://localhost:5173
# RESET_TOKEN_EXPIRE_MINUTES=30
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@mindhug.local
# SMTP_USE_TLS=true
