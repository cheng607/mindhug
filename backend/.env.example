# Database
DATABASE_URL=postgresql://mindhug:mindhug@localhost:5432/mindhug
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
DEBUG=true
UPLOAD_DIR=uploads

# 限流（每分钟请求数，Redis 多 worker 共享计数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_STRICT=20
RATE_LIMIT_WINDOW_SECONDS=60

# LLM（mock 为默认，无需 API Key；配置后启用真实 LLM）
LLM_PROVIDER=mock
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-api-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_MAX_CONTEXT_MESSAGES=20
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7

# Embedding（RAG 向量化，mock 模式下使用确定性伪向量）
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=3
